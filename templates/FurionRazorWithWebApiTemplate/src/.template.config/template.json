{
  "$schema": "http://json.schemastore.org/template",
  "author": "百小僧",
  "classifications": ["Furion", "Razor", "Pages", "WebApi", "Api"],
  "name": "Furion Razor With WebApi",
  "identity": "Furion.Template.RazorWithWebApi",
  "shortName": "furionrazorapi",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "FurionRazorApi",
  "preferNameDirectory": true,
  "symbols": {
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net8.0",
          "displayName": ".NET 8",
          "description": ".NET8 脚手架"
        },
        {
          "choice": "net9.0",
          "displayName": ".NET 9",
          "description": ".NET9 脚手架"
        },
        {
          "choice": "net10.0",
          "displayName": ".NET 10",
          "description": ".NET10 脚手架"
        },
        {
          "choice": "net11.0",
          "displayName": ".NET 11",
          "description": ".NET11 脚手架"
        }
      ],
      "replaces": "$(framework)",
      "defaultValue": "net10.0",
      "description": "选择要创建的 .NET8-11 脚手架"
    },
    "net8": {
      "type": "computed",
      "value": "(framework == \"net8.0\")"
    },
    "net9": {
      "type": "computed",
      "value": "(framework == \"net9.0\")"
    },
    "net10": {
      "type": "computed",
      "value": "(framework == \"net10.0\")"
    },
    "net11": {
      "type": "computed",
      "value": "(framework == \"net11.0\")"
    }
  }
}
